# Cloudflare Pages redirects
# https://developers.cloudflare.com/pages/configuration/redirects/

# Force the canonical host (no www)
https://www.bpleon.com/* https://bpleon.com/:splat 301

# RSS / feed alias
/feed       /feed.xml        200
/rss        /feed.xml        200

# NOTE: Pretty-URL rules like "/about /about.html 200" were removed
# because Cloudflare Pages now auto-redirects /foo.html -> /foo
# (canonical clean URLs), which collides with these rewrites and
# causes ERR_TOO_MANY_REDIRECTS. Cloudflare Pages already serves
# .html files at their clean-URL paths by default, so the rules
# were redundant anyway.
